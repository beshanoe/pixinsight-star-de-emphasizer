{
  "name": "pi-star-de-emphasizer",
  "private": "true",
  "version": "0.2.2",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "pixinscript build --no-zip",
    "build:ci": "pixinscript build",
    "dev": "pixinscript dev",
    "zip": "pixinscript zip -f StarDe-emphasizer.zip -p src/scripts/AstroSwell/StarDe-emphasizer",
    "sha": "sha1sum dist/StarDe-emphasizer.zip | awk '{print $1}'"
  },
  "pixinscript": {
    "script": {
      "featureId": "AstroswellStarDeemphasizer : AstroSwell > Star De-emphasizer",
      "featureInfo": "Star De-emphasizer script"
    }
  },
  "dependencies": {
    "@pixinscript/cli": "^0.3.1",
    "@pixinscript/core": "^0.2.1",
    "@pixinscript/react": "^0.2.1",
    "@pixinscript/ui": "^0.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@pixinscript/typescript-config": "^0.2.1",
    "@types/react": "^18.3.3"
  }
}
